{
  "name": "kainella-booking-service",
  "version": "1.0.0",
  "description": "Agritourism booking and reservation service for Kaynela Farms Ltd",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
