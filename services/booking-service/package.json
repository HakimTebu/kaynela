    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "amqplib": "^0.10.3",
    "redis": "^4.6.7",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "uuid": "^9.0.0",
    "moment": "^2.29.4",
    "prom-client": "^13.2.0",
    "express-prometheus-middleware": "^1.2.0",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.1",
    "rate-limit-redis": "^3.0.1",
