{
  "name": "kainella-auth-service",
  "version": "1.0.0",
  "description": "Authentication and authorization service for Kaynela Farms Ltd Agritourism Platform",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --watch src --exec node src/index.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "docker:build": "docker build -t kainella-auth-service .",
    "docker:run": "docker run -p 3001:3001 kainella-auth-service",
    "health": "curl -f http://localhost:3001/api/auth/health || exit 1"
  },
  "keywords": [
    "authentication",
    "authorization",
    "jwt",
    "oauth",
    "microservice",
    "kainella",
    "farms",
    "agritourism",
    "booking",
    "loyalty"
  ],
  "author": "Kaynela Farms Development Team",
  "license": "MIT",
  "dependencies": {
    "@elastic/elasticsearch": "^8.11.3",
    "amqplib": "^0.10.3",
    "bcryptjs": "^2.4.3",
    "connect-redis": "^7.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "qrcode": "^1.5.3",
    "rate-limit-redis": "^3.0.1",
    "redis": "^4.6.10",
    "speakeasy": "^2.0.0",
    "uuid": "^9.0.1",
    "validator": "^13.11.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "prom-client": "^13.0.0",
    "express-prometheus-middleware": "^1.2.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kainella/microservices.git",
    "directory": "services/auth-service"
  },
  "bugs": {
    "url": "https://github.com/kainella/microservices/issues"
  },
  "homepage": "https://github.com/kainella/microservices#readme"
}
