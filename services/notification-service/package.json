{
  "name": "kainella-notification-service",
  "version": "1.0.0",
  "description": "Enterprise-grade notification service for Kaynela Farms agritourism platform",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "docker:build": "docker build -t kainella-notification-service .",
    "docker:run": "docker run -p 3006:3006 kainella-notification-service"
  },
  "keywords": [
    "notification",
    "microservice",
    "agritourism",
    "kaynela-farms",
    "email",
    "sms",
    "push-notifications",
    "rabbitmq",
    "mongodb",
    "redis"
  ],
  "author": "Kaynela Farms Development Team",
  "license": "MIT",
  "dependencies": {
    "amqplib": "^0.10.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-prometheus-middleware": "^1.2.0",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "firebase-admin": "^13.4.0",
    "helmet": "^7.1.0",
    "moment": "^2.29.4",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.4",
    "prom-client": "^13.2.0",
    "rate-limit-redis": "^3.0.1",
    "redis": "^4.6.7",
    "twilio": "^4.12.0",
    "uuid": "^9.0.0",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.4",
    "eslint": "^8.47.0",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kaynela-farms/notification-service.git"
  },
  "bugs": {
    "url": "https://github.com/kaynela-farms/notification-service/issues"
  },
  "homepage": "https://github.com/kaynela-farms/notification-service#readme"
}
